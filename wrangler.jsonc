{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oracle-ai",
  "main": "worker.js",
  "compatibility_date": "2026-10-12",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "GEMINI_MODEL": "gemini-3.5-flash-lite"
  }
}
